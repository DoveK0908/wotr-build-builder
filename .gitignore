# ── 旧 Tkinter 工具：自带独立 git 仓库，作为归档放在这里，不纳入主仓库 ──
/archive/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node / 前端 ──
node_modules/
dist/
.vite/
*.tsbuildinfo

# ── 提取过程的中间缓存（体积大、可重建）──
/data/_raw/
/cache/

# ── 从本机游戏提取的素材（约 50 MB 二进制；用 pipeline/extract_ui.py 重建）──
#     不纳入仓库：体积大，且游戏界面贴图与图标是 Owlcat 的版权素材，只在本地使用。
/web/public/assets/

# ── 用户提供的游戏参考截图（约 90 MB，仅本地比对用）──
/example pictures/

# ── 杂项 ──
*.log
*.tmp
.DS_Store
Thumbs.db
web/.smoke/
dist-public/
